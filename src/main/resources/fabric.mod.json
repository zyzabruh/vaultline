{
  "schemaVersion": 1,
  "id": "vaultline",
  "version": "${version}",
  "name": "Vaultline",
  "description": "44 modules for stash organisation, travel and flight, base hunting and rendering, plus two GUI themes and the ClickGUI of the zio client. The stash organiser opens every nearby storage block and reorganises the stash in place: item groups, item frame labels, shulker packing.",
  "authors": [
    "pro0101"
  ],
  "license": "GPL-3.0-or-later",
  "contact": {
    "sources": "https://github.com/pro0101/vaultline"
  },
  "icon": "assets/vaultline/icon.png",
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "com.pro0101.vaultline.VaultlineAddon"
    ]
  },
  "mixins": [
    "vaultline.mixins.json"
  ],
  "accessWidener": "vaultline.accesswidener",
  "custom": {
    "meteor-client:color": "90,200,120",
    "modmenu": {
      "parent": {
        "id": "meteor-client"
      }
    }
  },
  "depends": {
    "java": ">=21",
    "minecraft": [
      "${mc_version}"
    ],
    "meteor-client": "*"
  }
}
